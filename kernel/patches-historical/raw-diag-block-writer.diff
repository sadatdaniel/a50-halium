-		ramdisk_execute_command = NULL;
-		prepare_namespace();
+	raw_diag_write(0, "DIAG slot0: about to check sys_access on ramdisk_execute_command");
+
+	{
+		int __diag_ret = sys_access((const char __user *) ramdisk_execute_command, 0);
+		char __diag_buf[128];
+		snprintf(__diag_buf, sizeof(__diag_buf), "DIAG slot1: sys_access(%s,0) = %d", ramdisk_execute_command, __diag_ret);
+		raw_diag_write(1, __diag_buf);
+
+		if (__diag_ret != 0) {
+			raw_diag_write(2, "DIAG slot2: access FAILED, going to prepare_namespace()");
+			ramdisk_execute_command = NULL;
+			prepare_namespace();
+			raw_diag_write(3, "DIAG slot3: prepare_namespace() returned");
+		} else {
+			raw_diag_write(2, "DIAG slot2: access SUCCEEDED, keeping ramdisk_execute_command");
+		}
 	}
 
