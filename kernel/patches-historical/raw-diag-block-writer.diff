+static void __init raw_diag_write2(int slot, const char *msg)
+{
+	int fd;
+	char devpath[] = "/diagdev2";
+	char buf[512];
+	loff_t pos;
+	mm_segment_t old_fs;
+
+	memset(buf, 0, sizeof(buf));
+	snprintf(buf, sizeof(buf), "%s", msg);
+	printk(KERN_EMERG "RAWDIAG: %s\n", msg);
+
+	old_fs = get_fs();
+	set_fs(KERNEL_DS);
+
+	sys_unlink((const char __user *)devpath);
+	if (sys_mknod((const char __user *)devpath, S_IFBLK | 0600, MKDEV(259, 16)) < 0) {
+		set_fs(old_fs);
+		return;
+	}
+
+	fd = sys_open((const char __user *)devpath, O_WRONLY, 0);
+	if (fd < 0) {
+		set_fs(old_fs);
+		return;
+	}
+
+	pos = (loff_t)(1500010 + slot) * 512;
+	sys_lseek(fd, pos, SEEK_SET);
+	sys_write(fd, buf, sizeof(buf));
+	sys_close(fd);
+	sys_sync(); /* debug patch: force write-through, don't lose it to a later crash/reboot */
+	set_fs(old_fs);
+}
