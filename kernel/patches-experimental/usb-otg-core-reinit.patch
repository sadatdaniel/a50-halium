Subject: [PATCH] usb: dwc3: restore active gadget hardware after sleep

Experimental follow-up to usb-otg-system-sleep.patch. On aa9 real
sleep left endpoint commands timing out; only a cable cycle recovered
the gadget. Pair core exit/init without holding the IRQ spinlock.

--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -1788,7 +1788,21 @@
 			    dwc->dotg->otg.state == OTG_STATE_B_PERIPHERAL &&
 			    dwc->gadget_driver && dwc->softconnect &&
 			    dwc->vbus_session) {
-				ret = dwc3_gadget_resume(dwc);
+				/* Drop existing PHY references before reinitializing.
+				 * PHY operations may sleep. Keep the role mutex,
+				 * but release the IRQ spinlock around them.
+				 */
+				spin_unlock_irqrestore(&dwc->lock, flags);
+				dwc3_core_exit(dwc);
+				ret = dwc3_core_init(dwc);
+				spin_lock_irqsave(&dwc->lock, flags);
+				if (!ret) {
+					dwc3_set_mode(dwc, DWC3_GCTL_PRTCAP_DEVICE);
+					/* Recheck binding after the sleeping operations. */
+					if (dwc->gadget_driver && dwc->softconnect &&
+					    dwc->vbus_session)
+						ret = dwc3_gadget_resume(dwc);
+				}
 				dev_info(dwc->dev,
 					 "system sleep: OTG gadget restore result=%d\n", ret);
 			}
