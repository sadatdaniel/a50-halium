From: A50 Ubuntu Touch development
Subject: [PATCH] sched/rt: use existing helpers when RT group scheduling is disabled

Samsung's RT PELT callbacks directly access rq/my_q fields which only exist
with CONFIG_RT_GROUP_SCHED. Reuse the existing upstream Linux 4.14 helpers
rq_of_rt_rq and rt_entity_is_task, which already handle both configurations.
Drop the unused private entity_is_task macro. Group-enabled evaluation is
unchanged; group-disabled builds use the existing container/task definitions.

Base: bec0c2aff1ee8a02ac9f582d60fe611f1d2bc939
Upstream helpers: https://github.com/torvalds/linux/blob/v4.14/kernel/sched/rt.c

--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -676,7 +676,6 @@
 #ifdef CONFIG_SMP
 
 #include "sched-pelt.h"
-#define entity_is_task(se)	(!se->my_q)
 
 extern u64 decay_load(u64 val, u64 n);
 
@@ -2403,7 +2402,7 @@
 void rt_rq_util_change(struct rt_rq *rt_rq)
 {
 	if (&this_rq()->rt == rt_rq)
-		cpufreq_update_util(rt_rq->rq, SCHED_CPUFREQ_RT);
+		cpufreq_update_util(rq_of_rt_rq(rt_rq), SCHED_CPUFREQ_RT);
 }
 
 #ifdef CONFIG_RT_GROUP_SCHED
@@ -2508,7 +2507,7 @@
 	update_rt_rq_load_avg(now, cpu, rt_rq, rt_rq->curr == rt_se);
 	propagate_entity_rt_load_avg(rt_se);
 
-	if (entity_is_task(rt_se))
+	if (rt_entity_is_task(rt_se))
 		trace_sched_rt_load_avg_task(rt_task_of(rt_se), &rt_se->avg);
 }
 
