# Kernel config fragment needed for lxc-net.service / lxc@android.service to
# work - this device's stock kernel .config had none of these. Found in two
# rounds, each diagnosed from the actual lxc-net error message (see
# SESSION_JOURNAL.md "LXC android container" section):
#
# Round 1 - "RTNETLINK answers: Operation not supported" when creating the
# bridge device itself:
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_VLAN_8021Q=y
CONFIG_MACVLAN=y
#
# Round 2 - bridge device creation then succeeded, but lxc-net's iptables/
# ip6tables NAT rule setup then failed ("Extension CHECKSUM revision 0 not
# supported", "ip6tables ... can't initialize ip6tables table `nat'"):
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_NAT_IPV6=y
CONFIG_IP6_NF_NAT=y
#
# Round 3 - traced with `bash -x /usr/libexec/lxc/lxc-net start` (this is
# what finally pinned down the ACTUAL fatal line - everything else in the
# log was either working fine or benign cleanup-path noise from `set +e`
# code deleting rules that were never added because of THIS failure):
# `ip6tables -t nat -A POSTROUTING ... -j MASQUERADE` ->
# "Extension MASQUERADE revision 0 not supported" -> exit. IPv6 masquerade
# is a SEPARATE Kconfig symbol from the IP6_NF_NAT framework enabled in
# round 2 - found via `grep -B2 -A5 MASQUERADE net/ipv6/netfilter/Kconfig`
# in the kernel source tree (this option auto-selects
# CONFIG_NF_NAT_MASQUERADE_IPV6, no need to set that separately):
CONFIG_IP6_NF_TARGET_MASQUERADE=y
#
# Round 4 (technically a separate bug, not this file's original networking
# topic, but found in the same debugging arc and needs the same "verify on
# a live boot" discipline): after rounds 1-3, lxc-net.service succeeded
# (lxcbr0 genuinely existed) but lxc-start still failed with a BPF cgroup2
# device program load error, then (after also fixing that - see the
# CONFIG_CMDLINE entry needed alongside this, in a50-fixes context) a
# generic "Failed to clone a new set of namespaces" (EINVAL). Isolated via
# `unshare --ipc --fork` specifically failing (every OTHER individual
# namespace flag - mount/uts/pid/net/cgroup - worked fine alone). Root
# cause: CONFIG_IPC_NS `depends on (SYSVIPC || POSIX_MQUEUE)` and NEITHER
# was set on this device's defconfig (Android commonly strips full SysV IPC
# deliberately for security - safer to satisfy the OR via POSIX_MQUEUE
# instead of reviving the whole legacy SysV IPC stack):
CONFIG_POSIX_MQUEUE=y
#
# Apply via merge_config.sh / your build system's usual config-fragment
# mechanism, or append as "CONFIG_X=y" echo lines into the merged temp
# defconfig before the kernel build step (this is how Mint's own build.sh
# does it for this device - see the "Disable Samsung integrity/anti-exploit
# subsystems" block in build.sh, which is where these were actually added).
#
# ALWAYS verify with `grep CONFIG_X /path/to/.config` after the build that
# each option actually took effect - Kconfig silently drops a symbol whose
# dependencies aren't met with no error (learned the hard way earlier this
# session with CONFIG_FRAMEBUFFER_CONSOLE/CONFIG_VT).
